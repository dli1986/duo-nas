# local data volumes (Postgres, Navidrome index/cache) — populated by docker compose
/data/*
!/data/.gitkeep

# actual media — lives here locally, never committed
/music/*
!/music/.gitkeep
/photos/*
!/photos/.gitkeep
/photos-originals/*
!/photos-originals/.gitkeep

# secrets
.env

# python virtual environment
.venv/
__pycache__/

# OS/editor cruft
.DS_Store
Thumbs.db

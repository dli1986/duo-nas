POSTGRES_USER=duonas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=duonas

# Where container state (DB files, Navidrome index/cache) lives.
# Dev laptop: leave as default (./state, next to this file).
# Real NAS: point at the external drive, e.g. /mnt/usb1/duonas-state
DUONAS_STATE_DIR=./state

# Where the actual media library lives (the thing you'd move to an external drive).
# Dev laptop: leave as default (./music).
# Real NAS: point at the external drive, e.g. /mnt/usb1/music
DUONAS_MUSIC_DIR=./music

# Cloudflare R2 (photo/thumbnail hosting) — from the R2 dashboard: bucket Settings for
# the public URL, "Manage API Tokens" for the rest. Never commit the real values.
R2_ACCOUNT_ID=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET=duo-li-media
# The bucket's Public Development URL (Settings > Public Development URL) — fine for now,
# switch to a Custom Domain once a real domain exists (R2 flags the dev URL as non-production).
R2_PUBLIC_URL=https://pub-7fd1a482bf2f4546a29fd95391a357f3.r2.dev
